{
  "name": "infernocms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "InfernoCMS monorepo. Root re-exports the core package so GitHub consumers can `import from 'infernocms'`.",
  "license": "AGPL-3.0-only",
  "main": "./packages/core/dist/index.js",
  "types": "./packages/core/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/core/dist/index.d.ts",
      "import": "./packages/core/dist/index.js",
      "default": "./packages/core/dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "packages/core/dist",
    "packages/core/package.json"
  ],
  "scripts": {
    "dev": "pnpm --filter infernocms-basic-example dev",
    "build": "pnpm --filter infernocms build",
    "build:docs": "pnpm --filter @infernocms/docs build",
    "test": "pnpm --filter infernocms test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.986.0",
    "@electric-sql/pglite": "^0.2.15",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^9.0.0",
    "cac": "^6.7.14",
    "fastify": "^5.2.0",
    "jiti": "^2.4.2",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0"
}
