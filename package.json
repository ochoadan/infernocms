{
  "name": "infernocms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "InfernoCMS monorepo. Root re-exports the core package so GitHub consumers can `import from 'infernocms'`.",
  "license": "AGPL-3.0-only",
  "main": "./packages/core/dist/index.js",
  "types": "./packages/core/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/core/dist/index.d.ts",
      "import": "./packages/core/dist/index.js",
      "default": "./packages/core/dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "packages/core/dist",
    "packages/core/package.json"
  ],
  "scripts": {
    "dev": "pnpm --filter infernocms-basic-example dev",
    "build": "pnpm --filter infernocms build && pnpm --filter @infernocms/admin build",
    "build:docs": "pnpm --filter @infernocms/docs build",
    "test": "pnpm --filter infernocms test"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0"
}
